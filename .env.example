# Environment Variables Template
# Copy this file to .env and fill in with your actual values
# NOTE: Never commit .env file with real values to version control

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Database (if applicable)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cybernetics_db
# DB_USER=user
# DB_PASSWORD=password

# API Configuration (if applicable)
# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=false

# Project Settings
DEBUG=false
ENVIRONMENT=development

# Add your own environment variables below
# CUSTOM_VAR=value
