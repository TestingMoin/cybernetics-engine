# STAGING / PAPER SAFE DEFAULTS
CYBERNETICS_SERVICE_NAME=cybernetics-engine
CYBERNETICS_ENV=staging
CYBERNETICS_TRADING_MODE=paper
CYBERNETICS_ORDER_SUBMISSION_ENABLED=false
CYBERNETICS_RUNTIME_POLL_SECONDS=1.0
CYBERNETICS_DATA_DIR=/opt/cybernetics-engine
CYBERNETICS_SECRET_DIR=/opt/cybernetics-engine/secrets

# Configure only on the VPS secret environment when staging database is ready.
# Never commit credentials here.
# CYBERNETICS_POSTGRES_DSN=
